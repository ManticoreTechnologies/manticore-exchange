/*
    This file is the TypeScript configuration file for the node environment.
    It is used to configure the TypeScript compiler for the node environment.
*/
{
  "compilerOptions": {
    "composite": true, // generate a declaration file for each module
    "skipLibCheck": true, // skip checking the types of libraries
    "module": "ESNext", // use ESNext modules
    "moduleResolution": "bundler", // use bundler to resolve modules
    "allowSyntheticDefaultImports": true, // allow synthetic default imports
    "strict": true // enforce strict type checking
  },
  "include": ["vite.config.ts"]
}
